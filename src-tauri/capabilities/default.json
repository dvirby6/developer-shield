{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Workspace folders are granted at runtime by the native picker. App-data access is limited to the app's own state directory for custom rules and scan history.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm"
  ]
}
